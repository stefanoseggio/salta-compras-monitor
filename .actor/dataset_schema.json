{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "actorSpecification": 1,
    "title": "Dataset Schema",
    "fields": {
        "type": "object",
        "properties": {
            "record_id": { "title": "Record ID", "type": "string" },
            "titulo": { "title": "Titulo", "type": "string" },
            "tipoPublicacion": { "title": "Tipo Publicacion", "type": "string" },
            "numeroPublicacion": { "title": "Numero Publicacion", "type": "string" },
            "fechaApertura": { "title": "Fecha Apertura", "type": "string" },
            "horaApertura": { "title": "Hora Apertura", "type": "string" },
            "objeto": { "title": "Objeto", "type": "string" },
            "organismo": { "title": "Organismo", "type": "string" },
            "expediente": { "title": "Expediente", "type": "string" },
            "consultaPliego": { "title": "Consulta y Adquisicion Pliego", "type": "string" },
            "consultas": { "title": "Consultas", "type": "string" },
            "event_type": {
                "title": "Event Type",
                "type": "string",
                "description": "NEW_LISTING (never seen before), UPDATED (a fingerprinted field changed), UNCHANGED (only when Only new is off) or CLOSED (no longer vigente - closed, resolved, expired or withdrawn; the source does not say which)."
            },
            "is_new": { "title": "Is New", "type": "boolean" },
            "contentHash": {
                "title": "Content Hash",
                "type": "string",
                "description": "sha1 fingerprint of this record's changeable fields - used to detect UPDATED between runs."
            },
            "source_url": { "title": "Source URL", "type": "string" },
            "detail": {
                "title": "Detail",
                "type": ["object", "null"],
                "properties": {
                    "fields": { "type": "object" },
                    "pdfUrl": { "type": ["string", "null"] },
                    "archivosAdjuntos": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "nombre": { "type": "string" },
                                "url": { "type": "string" }
                            }
                        }
                    }
                }
            },
            "scraped_at": { "title": "Scraped at", "type": "string" }
        }
    },
    "views": {
        "overview": {
            "title": "Overview",
            "transformation": {
                "fields": [
                    "record_id",
                    "tipoPublicacion",
                    "numeroPublicacion",
                    "organismo",
                    "objeto",
                    "fechaApertura",
                    "horaApertura",
                    "is_new"
                ]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "ID", "format": "text", "field": "record_id" },
                    { "label": "Tipo", "format": "text", "field": "tipoPublicacion" },
                    { "label": "Numero", "format": "text", "field": "numeroPublicacion" },
                    { "label": "Organismo", "format": "text", "field": "organismo" },
                    { "label": "Objeto", "format": "text", "field": "objeto" },
                    { "label": "Apertura", "format": "text", "field": "fechaApertura" },
                    { "label": "Hora", "format": "text", "field": "horaApertura" },
                    { "label": "Nuevo", "format": "boolean", "field": "is_new" }
                ]
            }
        },
        "changes": {
            "title": "Status changes & amendments",
            "transformation": {
                "fields": ["record_id", "event_type", "tipoPublicacion", "organismo", "objeto", "fechaApertura", "source_url", "scraped_at"]
            },
            "display": {
                "component": "table",
                "columns": [
                    { "label": "ID", "format": "text", "field": "record_id" },
                    { "label": "Evento", "format": "text", "field": "event_type" },
                    { "label": "Tipo", "format": "text", "field": "tipoPublicacion" },
                    { "label": "Organismo", "format": "text", "field": "organismo" },
                    { "label": "Objeto", "format": "text", "field": "objeto" },
                    { "label": "Apertura", "format": "text", "field": "fechaApertura" },
                    { "label": "URL", "format": "link", "field": "source_url" },
                    { "label": "Detectado", "format": "date", "field": "scraped_at" }
                ]
            }
        }
    }
}
